---
import { getCollection } from 'astro:content';
import Page from '../../../components/ProjectPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects', (e) => e.id.startsWith('fr/'));
  return entries.map((entry) => ({ params: { slug: entry.id.split('/').pop() }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Page lang="fr" entry={entry} />
